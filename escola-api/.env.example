DATABASE_URL="mysql://root@127.0.0.1:3306/betteryou_kids"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
# Origens explícitas do frontend (nunca "*" com credentials: true)
CORS_ORIGIN="http://localhost:8080,http://localhost:5173,http://escola-frontend.test"
# Cookies HttpOnly: Secure em produção por omissão; force com true/false
COOKIE_SECURE="false"
# Swagger: activo em desenvolvimento; em produção só com SWAGGER_ENABLED=true
# SWAGGER_ENABLED="true"
UPLOAD_DIR="./uploads"
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_FROM="BetterYou Kids <noreply@betteryoukids.com>"
# URL pública do frontend (portal). Usada em links de email; se omitida, usa o primeiro valor de CORS_ORIGIN.
PUBLIC_APP_URL="http://localhost:5173"
