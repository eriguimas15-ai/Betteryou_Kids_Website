# MySQL local (XAMPP/WAMP/serviço Windows). Com Docker Compose use o host
# do serviço (ex.: mysql://root:senha@db:3306/betteryou_kids) — não misturar
# hostname `db` com MySQL instalado em 127.0.0.1.
#
# Produção Namecheap/cPanel (MariaDB):
# DATABASE_URL="mysql://bettyuld_escola:SENHA@localhost:3306/bettyuld_betteryoukids"
DATABASE_URL="mysql://root@127.0.0.1:3306/betteryou_kids"

# --- Auth JWT (obrigatório) ---
# Produção/staging: segredos longos e aleatórios (≥32 chars). Nunca reutilizar change-me.
JWT_SECRET="change-me"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES_IN="7d"

# cPanel Node App define PORT automaticamente — não fixe em produção.
PORT=3001
# Host de bind (cPanel/Passenger: 0.0.0.0 por omissão no código)
# HOST=0.0.0.0

# --- CORS (obrigatório com cookies) ---
# Origens explícitas do frontend (nunca "*" com credentials: true).
# Produção betteryoukids (incluir www se o site redireccionar/servir ambos):
# CORS_ORIGIN="https://betteryoukids.com,https://www.betteryoukids.com"
CORS_ORIGIN="http://localhost:8080,http://localhost:5173,http://escola-frontend.test"

# --- Cookies HttpOnly ---
# Secure em produção por omissão (NODE_ENV=production). Local HTTP → false.
# Staging/prod HTTPS → true (ou omitir em production).
COOKIE_SECURE="false"
# SameSite: lax (omissão) — correcto para SPA em betteryoukids.com → API em api.betteryoukids.com
# (mesmo eTLD+1 = same-site). Só none se API noutro domínio: COOKIE_SAMESITE=none (+ Secure).
# COOKIE_SAMESITE="lax"

# --- Swagger ---
# Activo em desenvolvimento. Em produção: omitir ou SWAGGER_ENABLED=false.
# SWAGGER_ENABLED="true"
# Tokens no JSON de login/register/refresh: só para Swagger/Bearer. SPA = cookies — omitir.
# SWAGGER_RETURN_TOKENS="true"

# Relativo ao Application root (pasta api no cPanel) — garantir permissão de escrita
UPLOAD_DIR="./uploads"
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_FROM="BetterYou Kids <noreply@betteryoukids.com>"
# Produção: SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS do cPanel Email

# --- Frontend público (links de email) ---
# Staging/prod: URL HTTPS do portal. Se omitida, usa o primeiro valor de CORS_ORIGIN.
PUBLIC_APP_URL="http://localhost:5173"
# Produção: PUBLIC_APP_URL="https://betteryoukids.com"
